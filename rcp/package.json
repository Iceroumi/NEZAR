{
  "name": "nezar",
  "icon": "icon.png",
  "displayName": "Nezar",
  "description": "Мгновенный сбор кода для контекста (для AI )",
  "version": "0.6.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:nezar-section1",
    "onView:nezar-section2",
    "onView:nezar-section3"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nezar.mergeFiles",
        "title": "Собрать все файлы в один",
        "category": "Nezar"
      },
      {
        "command": "nezar.minifyFiles",
        "title": "Собрать все файлы без пробелов (минификация)",
        "category": "Nezar"
      },
      {
        "command": "nezar.copyCurrentFile",
        "title": "Копировать текущий файл",
        "category": "Nezar"
      },
      {
        "command": "nezar.treeList",
        "title": "Дерево проекта",
        "category": "Nezar"
      },
      {
  "command": "nezar.copyOpenFiles",
  "title": "Собрать открытые файлы",
  "category": "Nezar"
}
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nezar-sidebar",
          "title": "Nezar",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "nezar-sidebar": [
        {
          "id": "nezar-section1",
          "name": "Быстрые действия",
          "type": "webview"
        },
        {
          "id": "nezar-section2",
          "name": "Дерево контекста",
          "type": "webview"
        },
        {
          "id": "nezar-section3",
          "name": "прочие",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "ts-loader": "^9.6.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "main": "./dist/extension.js",
  "publisher": "marioden",
  "license": "MIT"
}